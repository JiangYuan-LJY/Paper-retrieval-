# Scopus API Key
# 填写你自己的 Scopus API key。
# 用途：从 Scopus 检索论文并获取论文元数据。
SCOPUS_API_KEY=your_scopus_api_key

# EasyScholar Secret Key
# 填写你自己的 EasyScholar secret key。
# 用途：查询期刊分区、期刊等级或排名信息。
EASYSCHOLAR_SECRET_KEY=your_easyscholar_secret_key

# 大模型评分中转站地址
# 填写 OpenAI 兼容格式的大模型中转站基础地址。
# 示例：https://aixor.org
# 如果不需要 Topic Relevance 和 Keyword Match 的大模型评分，可以留空。
PAPER_SCORING_API_URL=https://aixor.org

# 大模型评分中转站 API Key
# 填写你自己的中转站 API key。
# 注意：不要把真实 key 写进 .env.example。
# 真实 key 只应写入本地 .env 文件。
PAPER_SCORING_API_KEY=your_model_relay_key

# 大模型名称
# 填写中转站支持的模型名称。
# 示例：gpt-4o-mini、deepseek-chat，或你的中转站提供的其他模型名。
PAPER_SCORING_MODEL=your_model_name

# 大模型温度参数
# 控制模型输出随机性。
# 论文评分任务建议使用 0，使评分更稳定。
PAPER_SCORING_TEMPERATURE=0
